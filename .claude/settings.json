{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // \"\"'); if echo \"$CMD\" | grep -qE '(^|[[:space:]])git commit'; then cd /Users/lakshyalahoty/Desktop/projects/cardsNight && npm test 1>&2; if [ $? -ne 0 ]; then printf '{\"continue\":false,\"stopReason\":\"Tests failed — commit blocked. Fix the failures above before committing.\"}\\n'; fi; fi",
            "timeout": 120,
            "statusMessage": "Running tests before commit..."
          },
          {
            "type": "command",
            "command": "node /Users/lakshyalahoty/Desktop/projects/cardsNight/.claude/scripts/check-review-gate.js 2>&1 || exit 1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/lakshyalahoty/Desktop/projects/cardsNight/.claude/scripts/check-feedback-issues.js 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node /Users/lakshyalahoty/Desktop/projects/cardsNight/.claude/scripts/check-pr-status.js 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node /Users/lakshyalahoty/Desktop/projects/cardsNight/.claude/scripts/cleanup-reviews.js 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
